# ── JM ESCOLAR · Variables de entorno ────────────────────────────────
# Copia este archivo a `.env.local` y complétalo con los valores de tu
# proyecto de Supabase. NUNCA commitees `.env.local` (ya está en .gitignore).

# URL pública del proyecto Supabase (segura para el cliente)
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Clave anon/publishable (segura para el cliente — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key"

# Clave service_role — SOLO servidor. JAMÁS con prefijo NEXT_PUBLIC_.
# JAMÁS en el bundle del cliente, en logs, ni en commits. (Fort Knox #1)
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# URL base del sitio (para redirecciones de auth)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
